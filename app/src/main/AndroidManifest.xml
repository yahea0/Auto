<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- الصلاحيات القديمة... -->
    <application 
        android:label="Auto"
        android:theme="@style/Theme.MyAutomationApp">
        
        <activity android:name=".MainActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- أضف هذا السطر -->
        <activity android:name=".ActionActivity" android:exported="false" />

        <service android:name=".FloatingWindowService" 
                 android:foregroundServiceType="specialUse"
                 android:exported="false">
            <property android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE" android:value="Floating window" />
        </service>
    </application>
</manifest>
