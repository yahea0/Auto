<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- الصلاحيات الأساسية -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    
    <application 
        android:label="Auto"
        android:theme="@style/Theme.MyAutomationApp">
        
        <!-- 1. الشاشة الرئيسية -->
        <activity android:name=".MainActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 2. شاشة إدارة الأكشنات -->
        <activity android:name=".ActionActivity" android:exported="false" />

        <!-- 3. خدمة النافذة العائمة (الزر الدائري + القائمة) -->
        <service android:name=".FloatingWindowService" 
                 android:foregroundServiceType="specialUse"
                 android:exported="false">
            <property android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE" android:value="Floating window" />
        </service>

        <!-- 4. خدمة التقاط الإحداثيات (الدائرة الثانية اللي بتطلع فوق الشاشة) -->
        <service android:name=".CoordinatePickerService" 
                 android:exported="false" />

    </application>
</manifest>
