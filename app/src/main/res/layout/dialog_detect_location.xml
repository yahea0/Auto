<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="310dp"
    android:layout_height="wrap_content"
    app:cardBackgroundColor="#252525"
    app:cardCornerRadius="16dp"
    app:cardElevation="18dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Detect Location"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold"
            android:gravity="center"
            android:paddingBottom="14dp" />

        <!-- 1. Captured Location -->
        <LinearLayout
            android:id="@+id/rowLocCaptured"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="6dp">
            <RadioButton
                android:id="@+id/rbLocCaptured"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:buttonTint="#00E5FF" />
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Captured Location"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:textStyle="bold" />
                <TextView
                    android:id="@+id/tvCapturedCoordsDetails"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="[430, 987, 275, 188]"
                    android:textColor="#AAAAAA"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- 2. Custom Region -->
        <LinearLayout
            android:id="@+id/rowLocCustom"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="6dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <RadioButton
                    android:id="@+id/rbLocCustom"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:buttonTint="#00E5FF" />
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Custom Region"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:textStyle="bold" />
            </LinearLayout>
            <!-- صندوق إدخال وزر تأطير المنطقة المخصصة بصرياً (صورة 3) -->
            <LinearLayout
                android:id="@+id/layoutCustomRegionBox"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="#333333"
                android:layout_marginStart="36dp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp">
                <ImageView
                    android:id="@+id/btnPickCustomRegionFrame"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:src="@android:drawable/ic_menu_crop"
                    app:tint="#00E5FF" />
                <TextView
                    android:id="@+id/tvCustomRegionValues"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="X, Y, Width, Height"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:paddingStart="8dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- 3. Full Screen -->
        <LinearLayout
            android:id="@+id/rowLocFullScreen"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="6dp">
            <RadioButton
                android:id="@+id/rbLocFullScreen"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:buttonTint="#00E5FF" />
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Full Screen"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Detection will run at exactly where you specify thus achieve the highest accuracy."
            android:textColor="#888888"
            android:textSize="11sp"
            android:paddingTop="10dp"
            android:paddingBottom="14dp" />

        <!-- أزرار Save و Cancel -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="end">
            <Button
                android:id="@+id/btnLocCancel"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:text="CANCEL"
                android:background="@android:color/transparent"
                android:textColor="#C084FC"
                android:textStyle="bold" />
            <Button
                android:id="@+id/btnLocSave"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:text="SAVE"
                android:background="@android:color/transparent"
                android:textColor="#C084FC"
                android:textStyle="bold"
                android:layout_marginStart="8dp" />
        </LinearLayout>

    </LinearLayout>
</androidx.cardview.widget.CardView>
