<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="200dp"
    android:layout_height="wrap_content"
    app:cardBackgroundColor="#1E1E1E"
    app:cardCornerRadius="16dp"
    app:cardElevation="15dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <TextView
            android:id="@+id/menuManage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Manage Actions"
            android:textColor="#FFD700"
            android:padding="12dp"
            android:textStyle="bold"
            android:drawableStart="@android:drawable/ic_menu_manage"
            android:drawablePadding="12dp"
            android:drawableTint="#FFD700"
            android:gravity="center_vertical" />

        <TextView
            android:id="@+id/menuRunTest"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Run Test"
            android:textColor="#FFD700"
            android:padding="12dp"
            android:textStyle="bold"
            android:drawableStart="@android:drawable/ic_media_play"
            android:drawablePadding="12dp"
            android:drawableTint="#FFD700"
            android:gravity="center_vertical" />

        <TextView
            android:id="@+id/menuSave"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Save"
            android:textColor="#FFD700"
            android:padding="12dp"
            android:textStyle="bold"
            android:drawableStart="@android:drawable/ic_menu_save"
            android:drawablePadding="12dp"
            android:drawableTint="#FFD700"
            android:gravity="center_vertical" />

        <TextView
            android:id="@+id/menuMore"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="More"
            android:textColor="#FFD700"
            android:padding="12dp"
            android:textStyle="bold"
            android:drawableStart="@android:drawable/ic_menu_more"
            android:drawablePadding="12dp"
            android:drawableTint="#FFD700"
            android:gravity="center_vertical" />

        <TextView
            android:id="@+id/menuExit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Exit"
            android:textColor="#FFD700"
            android:padding="12dp"
            android:textStyle="bold"
            android:drawableStart="@android:drawable/ic_menu_close_clear_cancel"
            android:drawablePadding="12dp"
            android:drawableTint="#FFD700"
            android:gravity="center_vertical" />
    </LinearLayout>
</androidx.cardview.widget.CardView>
