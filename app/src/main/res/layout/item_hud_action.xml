<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="56dp"
    android:orientation="horizontal"
    android:background="@drawable/action_card_bg"
    android:gravity="center_vertical"
    android:paddingStart="10dp"
    android:paddingEnd="12dp"
    android:layout_marginBottom="6dp">

    <!-- أيقونة الأكشن داخل الدائرة الداكنة -->
    <ImageView
        android:id="@+id/ivActionIcon"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:background="@drawable/action_icon_circle"
        android:padding="8dp"
        android:src="@android:drawable/ic_menu_compass"
        app:tint="#FFFFFF" />

    <!-- نصوص الأكشن -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="10dp">

        <TextView
            android:id="@+id/tvActionTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Click [540, 1200] [C]"
            android:textColor="#1E1E1E"
            android:textStyle="bold"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tvActionSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="[X1] [Delay 0ms/1000ms]"
            android:textColor="#3E3E3E"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- رقم ترتيب الأكشن في مايكروفي (1, 2, 3...) -->
    <TextView
        android:id="@+id/tvActionIndex"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:background="@drawable/action_icon_circle"
        android:gravity="center"
        android:text="1"
        android:textColor="#FFFFFF"
        android:textSize="11sp"
        android:textStyle="bold" />

</LinearLayout>
