<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/action_card_bg"
    android:padding="10dp"
    android:layout_marginBottom="8dp">

    <!-- الجزء العلوي: الأكشن الأساسي (Click) -->
    <LinearLayout
        android:id="@+id/layoutMainActionClick"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/ivActionIcon"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/action_icon_circle"
            android:padding="8dp"
            android:src="@android:drawable/ic_menu_compass"
            app:tint="#FFFFFF" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="10dp">

            <TextView
                android:id="@+id/tvActionTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Click [540, 1200] [C]"
                android:textColor="#1E1E1E"
                android:textStyle="bold"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tvActionSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="[X1] [Delay 0ms/500ms]"
                android:textColor="#3E3E3E"
                android:textSize="11sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvActionIndex"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:background="@drawable/action_icon_circle"
            android:gravity="center"
            android:text="1"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- الجزء السفلي: شرط الصورة المتفرع (صورة 3) -->
    <LinearLayout
        android:id="@+id/layoutConditionBranch"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone"
        android:paddingTop="8dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="All true"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:textStyle="bold"
            android:background="#22C55E"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"
            android:layout_marginBottom="4dp" />

        <LinearLayout
            android:id="@+id/layoutNestedConditionCard"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="18dp"
            android:background="?attr/selectableItemBackground">

            <!-- عارض صورة الزر الحقيقية المقتصة (Thumbnail) -->
            <ImageView
                android:id="@+id/ivConditionThumb"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:background="#16A34A"
                android:scaleType="centerCrop"
                android:padding="6dp"
                android:src="@android:drawable/ic_menu_gallery"
                app:tint="#FFFFFF" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingStart="10dp">

                <TextView
                    android:id="@+id/tvConditionTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Image [img_1] [Appear] [70%]"
                    android:textColor="#1E1E1E"
                    android:textStyle="bold"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/tvConditionSubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="[Captured Location]"
                    android:textColor="#4E4E4E"
                    android:textSize="10sp" />
            </LinearLayout>

        </LinearLayout>
    </LinearLayout>

</LinearLayout>
