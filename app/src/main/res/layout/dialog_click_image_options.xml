<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="290dp"
    android:layout_height="wrap_content"
    app:cardBackgroundColor="#252525"
    app:cardCornerRadius="14dp"
    app:cardElevation="16dp">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxHeight="460dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="8dp"
            android:paddingBottom="8dp">

            <!-- 1. Change Image -->
            <LinearLayout
                android:id="@+id/optImgChangeImage"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:gravity="center_vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Change Image"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp" />
                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@android:drawable/ic_menu_edit"
                    app:tint="#C084FC" />
            </LinearLayout>

            <!-- 2. Edit Offset -->
            <LinearLayout
                android:id="@+id/optImgEditOffset"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:gravity="center_vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Edit Offset"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp" />
                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@android:drawable/ic_menu_edit"
                    app:tint="#C084FC" />
            </LinearLayout>

            <!-- 3. Edit Click Style -->
            <LinearLayout
                android:id="@+id/optImgEditClickStyle"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:gravity="center_vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Edit Click Style"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp" />
                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@android:drawable/ic_menu_edit"
                    app:tint="#C084FC" />
            </LinearLayout>

            <!-- 4. Edit Delay -->
            <LinearLayout
                android:id="@+id/optImgEditDelay"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:gravity="center_vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Edit Delay"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp" />
                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@android:drawable/ic_menu_edit"
                    app:tint="#C084FC" />
            </LinearLayout>

            <!-- 5. Edit Image -->
            <LinearLayout
                android:id="@+id/optImgEditImage"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:gravity="center_vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Edit Image"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp" />
                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@android:drawable/ic_menu_gallery"
                    app:tint="#C084FC" />
            </LinearLayout>

            <!-- 6. Test Action -->
            <LinearLayout
                android:id="@+id/optImgTestAction"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:gravity="center_vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Test Action"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp" />
                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@android:drawable/ic_media_play"
                    app:tint="#C084FC" />
            </LinearLayout>

            <!-- 7. Add Action (Above) -->
            <LinearLayout
                android:id="@+id/optImgAddAbove"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:gravity="center_vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Add Action (Above)"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp" />
                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@android:drawable/ic_input_add"
                    app:tint="#C084FC" />
            </LinearLayout>

            <!-- 8. Add Condition -->
            <LinearLayout
                android:id="@+id/optImgAddCondition"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:gravity="center_vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Add Condition"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp" />
                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@android:drawable/ic_input_add"
                    app:tint="#C084FC" />
            </LinearLayout>

            <!-- 9. Replace Action -->
            <LinearLayout
                android:id="@+id/optImgReplace"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:gravity="center_vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Replace Action"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp" />
                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@android:drawable/ic_menu_rotate"
                    app:tint="#C084FC" />
            </LinearLayout>

            <!-- 10. Convert to Custom Action -->
            <LinearLayout
                android:id="@+id/optImgConvertCustom"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:gravity="center_vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Convert to Custom Action"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp" />
                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@android:drawable/ic_menu_info_details"
                    app:tint="#C084FC" />
            </LinearLayout>

            <!-- 11. Copy -->
            <LinearLayout
                android:id="@+id/optImgCopy"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:gravity="center_vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Copy"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp" />
                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@android:drawable/ic_menu_crop"
                    app:tint="#C084FC" />
            </LinearLayout>

            <!-- 12. Cut -->
            <LinearLayout
                android:id="@+id/optImgCut"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:gravity="center_vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Cut"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp" />
                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@android:drawable/ic_menu_manage"
                    app:tint="#C084FC" />
            </LinearLayout>

            <!-- 13. Delete -->
            <LinearLayout
                android:id="@+id/optImgDelete"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:gravity="center_vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Delete"
                    android:textColor="#FF5252"
                    android:textSize="15sp"
                    android:textStyle="bold" />
                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@android:drawable/ic_menu_delete"
                    app:tint="#FF5252" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>
</androidx.cardview.widget.CardView>
