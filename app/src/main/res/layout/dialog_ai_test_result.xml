<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="320dp"
    android:layout_height="wrap_content"
    app:cardBackgroundColor="#1A1A1A"
    app:cardCornerRadius="18dp"
    app:cardElevation="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- الهيدر الذكي -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingBottom="12dp">

            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@android:drawable/ic_menu_search"
                app:tint="#00E5FF" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="  AI Vision Inspector"
                android:textColor="#00E5FF"
                android:textSize="18sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- بطاقة النسبة اللحظية الكبيرة -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#262626"
            android:padding="12dp"
            android:gravity="center"
            android:layout_marginBottom="12dp">

            <TextView
                android:id="@+id/tvAiExactSim"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="75.9%"
                android:textColor="#00E5FF"
                android:textSize="32sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvAiCurrentStatusBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⚠️ لن ينقر! النسبة الحالية أقل من المطلوب"
                android:textColor="#FF5252"
                android:textSize="12sp"
                android:textStyle="bold"
                android:paddingTop="4dp" />
        </LinearLayout>

        <!-- بطاقة النسب المتاحة للضغط بنجاح -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#242038"
            android:padding="12dp"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🎯 النسب المتاحة للضغط بنجاح:"
                android:textColor="#C084FC"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvAiAvailableRates"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="75, 74, 73, 72, 71, 70%"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold"
                android:paddingTop="4dp" />

            <TextView
                android:id="@+id/tvAiTargetSetting"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="النسبة المضبوطة حالياً بالأكشن: 95%"
                android:textColor="#AAAAAA"
                android:textSize="11sp"
                android:paddingTop="2dp" />
        </LinearLayout>

        <!-- زر تطبيق أفضل نسبة مقترحة -->
        <Button
            android:id="@+id/btnApplyRecommendedSim"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="⚡ تطبيق النسبة الذكية (71%)"
            android:backgroundTint="#00E5FF"
            android:textColor="#121212"
            android:textStyle="bold"
            android:textSize="13sp"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/btnCloseAiDialog"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:text="إغلاق"
            android:backgroundTint="#333333"
            android:textColor="#FFFFFF"
            android:textSize="13sp" />

    </LinearLayout>
</androidx.cardview.widget.CardView>
