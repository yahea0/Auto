<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="end">

    <!-- الدائرة الذهبية -->
    <androidx.cardview.widget.CardView
        android:id="@+id/circleButton"
        android:layout_width="60dp"
        android:layout_height="60dp"
        app:cardCornerRadius="30dp"
        app:cardBackgroundColor="#FFD700"
        app:cardElevation="8dp">

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@android:drawable/ic_menu_edit"
            android:padding="15dp"
            app:tint="#121212" />
    </androidx.cardview.widget.CardView>

    <!-- القائمة المنسدلة (تظهر لما نضغط على الدائرة) -->
    <LinearLayout
        android:id="@+id/menuLayout"
        android:layout_width="150dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#1E1E1E"
        android:visibility="gone"
        android:padding="5dp"
        android:layout_marginTop="8dp"
        android:elevation="8dp"
        app:cardCornerRadius="12dp">

        <TextView
            android:id="@+id/menuManage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Manage Actions"
            android:textColor="#FFD700"
            android:padding="10dp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/menuRunTest"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Run Test"
            android:textColor="#FFD700"
            android:padding="10dp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/menuSave"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Save"
            android:textColor="#FFD700"
            android:padding="10dp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/menuMore"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="More"
            android:textColor="#FFD700"
            android:padding="10dp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/menuExit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Exit"
            android:textColor="#FFD700"
            android:padding="10dp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>
