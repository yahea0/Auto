<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    app:cardBackgroundColor="#1E1E1E"
    app:cardCornerRadius="12dp"
    app:cardElevation="10dp">

    <LinearLayout
        android:layout_width="200dp"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- الهيدر (للسحب) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="#FFD700"
            android:padding="6dp"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/headerTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Main Job"
                android:textColor="#121212"
                android:textStyle="bold"
                android:textSize="14sp" />

            <ImageButton
                android:id="@+id/btnMenu"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@android:drawable/ic_menu_sort_by_size"
                android:background="@android:color/transparent"
                android:tint="#121212" />

            <ImageButton
                android:id="@+id/btnMinimize"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@android:drawable/ic_menu_close_clear_cancel"
                android:background="@android:color/transparent"
                android:tint="#121212" />
        </LinearLayout>

        <!-- المحتوى (الأكشنات) -->
        <LinearLayout
            android:id="@+id/expandedLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="8dp"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="No Actions"
                android:textColor="#FFFFFF"
                android:gravity="center"
                android:layout_marginTop="5dp"
                android:layout_marginBottom="5dp"/>

            <Button
                android:id="@+id/btnAddAction"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Add Action"
                android:background="#FFD700"
                android:textColor="#121212" />

        </LinearLayout>

        <!-- قائمة التحكم (اللي بتطلع لما نضغط على زر القائمة) -->
        <LinearLayout
            android:id="@+id/menuLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="5dp"
            android:visibility="gone"
            android:background="#1E1E1E">

            <TextView
                android:id="@+id/menuManage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Manage Actions"
                android:textColor="#FFD700"
                android:padding="10dp"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/menuRunTest"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Run Test"
                android:textColor="#FFD700"
                android:padding="10dp"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/menuSave"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Save"
                android:textColor="#FFD700"
                android:padding="10dp"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/menuMore"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="More"
                android:textColor="#FFD700"
                android:padding="10dp"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/menuExit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Exit"
                android:textColor="#FFD700"
                android:padding="10dp"
                android:textStyle="bold"/>
        </LinearLayout>

    </LinearLayout>
</androidx.cardview.widget.CardView>
