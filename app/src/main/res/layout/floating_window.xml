<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="end">

    <!-- الدائرة الذهبية الفخمة -->
    <androidx.cardview.widget.CardView
        android:id="@+id/circleButton"
        android:layout_width="48dp"
        android:layout_height="48dp"
        app:cardCornerRadius="24dp"
        app:cardBackgroundColor="@android:color/transparent"
        app:cardElevation="10dp">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/gold_circle">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@android:drawable/ic_menu_compass"
                android:padding="12dp"
                app:tint="#121212" />
        </FrameLayout>
    </androidx.cardview.widget.CardView>

    <!-- القائمة المنسدلة (تظهر لما نضغط على الدائرة) -->
    <androidx.cardview.widget.CardView
        android:id="@+id/menuLayout"
        android:layout_width="160dp"
        android:layout_height="wrap_content"
        android:visibility="gone"
        android:layout_marginTop="8dp"
        app:cardBackgroundColor="#1E1E1E"
        app:cardCornerRadius="12dp"
        app:cardElevation="10dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="4dp">

            <TextView
                android:id="@+id/menuManage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Manage Actions"
                android:textColor="#FFD700"
                android:padding="10dp"
                android:textStyle="bold"
                android:drawableStart="@android:drawable/ic_menu_manage"
                android:drawablePadding="8dp"
                android:drawableTint="#FFD700"
                android:gravity="center_vertical"/>

            <TextView
                android:id="@+id/menuRunTest"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Run Test"
                android:textColor="#FFD700"
                android:padding="10dp"
                android:textStyle="bold"
                android:drawableStart="@android:drawable/ic_media_play"
                android:drawablePadding="8dp"
                android:drawableTint="#FFD700"
                android:gravity="center_vertical"/>

            <TextView
                android:id="@+id/menuSave"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Save"
                android:textColor="#FFD700"
                android:padding="10dp"
                android:textStyle="bold"
                android:drawableStart="@android:drawable/ic_menu_save"
                android:drawablePadding="8dp"
                android:drawableTint="#FFD700"
                android:gravity="center_vertical"/>

            <TextView
                android:id="@+id/menuMore"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="More"
                android:textColor="#FFD700"
                android:padding="10dp"
                android:textStyle="bold"
                android:drawableStart="@android:drawable/ic_menu_more"
                android:drawablePadding="8dp"
                android:drawableTint="#FFD700"
                android:gravity="center_vertical"/>

            <TextView
                android:id="@+id/menuExit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Exit"
                android:textColor="#FFD700"
                android:padding="10dp"
                android:textStyle="bold"
                android:drawableStart="@android:drawable/ic_menu_close_clear_cancel"
                android:drawablePadding="8dp"
                android:drawableTint="#FFD700"
                android:gravity="center_vertical"/>
        </LinearLayout>
    </androidx.cardview.widget.CardView>

</LinearLayout>
