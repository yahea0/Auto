<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="70dp"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="#2C2C2C"
    android:padding="8dp"
    android:layout_marginBottom="8dp">

    <!-- معاينة الصورة المصغرة الحقيقية -->
    <ImageView
        android:id="@+id/ivExistThumbPreview"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:background="#1E1E1E"
        android:scaleType="centerCrop" />

    <!-- بيانات القالب -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="12dp">

        <TextView
            android:id="@+id/tvExistImageName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Template_1"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvExistImageDimensions"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="[100 x 100 px]"
            android:textColor="#00E5FF"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- زر حذف هذا القالب المستقل 🗑️ -->
    <ImageView
        android:id="@+id/btnDeleteTemplateItem"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:src="@android:drawable/ic_menu_delete"
        android:padding="6dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        app:tint="#FF5252" />

</LinearLayout>
