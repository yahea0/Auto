<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="320dp"
    android:layout_height="wrap_content"
    app:cardBackgroundColor="#222222"
    app:cardCornerRadius="16dp"
    app:cardElevation="18dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingBottom="12dp">

            <TextView
                android:id="@+id/tvManagerHeaderTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Trained Templates"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold" />

            <!-- زر إضافة لقطة جديدة -->
            <Button
                android:id="@+id/btnAddNewTrainedTemplate"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="+ Add"
                android:backgroundTint="#00E5FF"
                android:textColor="#121212"
                android:textStyle="bold"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- قائمة القوالب القابلة للتمرير -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxHeight="360dp">

            <LinearLayout
                android:id="@+id/layoutTemplatesListContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </ScrollView>

        <Button
            android:id="@+id/btnCloseTemplateManager"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:text="Close"
            android:backgroundTint="#333333"
            android:textColor="#FFFFFF"
            android:layout_marginTop="12dp" />

    </LinearLayout>
</androidx.cardview.widget.CardView>
